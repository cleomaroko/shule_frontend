# ---------------------------------------------------------------------------
# Dira frontend configuration
#
# Copy to `.env.local` and adjust as needed:
#   cp .env.example .env.local
#
# WARNING: every VITE_* value is embedded in the JavaScript bundle and is
# therefore PUBLIC. Never put secrets here (JWT signing keys, SMTP or database
# credentials, API keys).
# ---------------------------------------------------------------------------

# Base URL for the backend API, including the `/api` prefix.
#
# Leave as the relative default in development: requests stay same-origin and
# Vite forwards them to the backend, which avoids CORS entirely because the
# Spring Boot app registers no CORS policy.
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards `/api` requests. Development only —
# this is not used in a production build.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Product name used in the UI, page titles and brand lockup.
VITE_APP_NAME=Dira

# Public path the SPA is served from. Leave unset (or `/`) for local `npm run
# dev`. Production Docker sets this to `/dira/` so the app can sit next to the
# existing nginx backend proxy at `location /`.
# VITE_BASE_PATH=/dira/

# ---------------------------------------------------------------------------
# Connecting directly to the backend instead of via the dev proxy
#
# Set the full base URL below and the proxy is bypassed. This requires CORS to
# be enabled on the Java backend first — see the "Backend requirements" section
# of README.md.
#
#   VITE_API_BASE_URL=http://localhost:8080/api
# ---------------------------------------------------------------------------
